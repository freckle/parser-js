{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@freckle/tsconfig/library.json",
  "compilerOptions": {
    // `atob` and `console` are browser globals: this package is consumed in
    // browser contexts. Additive to the shared set, and `lib` replaces rather
    // than merges, so ES2023 has to be restated alongside DOM.
    "lib": ["ES2023", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts"]
}
