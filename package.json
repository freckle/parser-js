{
  "name": "@freckle/parser",
  "version": "2.0.0",
  "description": "One that parses",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/parser-js.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format-check": "prettier --check 'src/**/*.ts'",
    "lint": "eslint",
    "knip": "knip"
  },
  "dependencies": {
    "@freckle/exhaustive": "^2.0.0",
    "@freckle/maybe": "^3.0.0",
    "@freckle/non-empty": "^6.0.0",
