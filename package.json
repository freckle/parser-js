{
  "name": "@freckle/parser",
  "version": "2.0.0",
  "description": "One that parses",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/parser-js.git"
  },
  "scripts": {
    "build": "rm -r dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format-check": "prettier --check 'src/**/*.ts'",
    "lint": "eslint",
    "knip": "knip"
  },
  "dependencies": {
    "@freckle/exhaustive": "^2.0.0",
    "@freckle/maybe": "^3.0.0",
    "@freckle/non-empty": "^3.0.0",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "knip": "^6.32.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
